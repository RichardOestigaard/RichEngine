{
  "name": "LFM3-1.7B",
  "repos": [
    "LiquidAI/LFM3-1.7B-GGUF",
    "LiquidAI/LFM3-1.7B-MLX-4bit",
    "LiquidAI/LFM3-1.7B"
  ],
  "note": "Tri-hybrid: thirteen conv layers, five sliding_window_attention layers (4, 8, 12, 16, 20) and six full_attention layers (2, 6, 10, 14, 18, 22), as config.json's layer_types states them. Per-head gate_proj and sandwich norms; gate_proj rides unquantized.",
  "signature": {
    "model_type": "lfm3",
    "hidden_size": 2048,
    "num_hidden_layers": 24,
    "vocab_size": 128000,
    "num_attention_heads": 16,
    "num_key_value_heads": 4,
    "head_dim": 128,
    "intermediate_size": 7680,
    "conv_L_cache": 7,
    "use_sandwich_norm": true,
    "sliding_window": 256,
    "norm_eps": 1e-05,
    "tie_word_embeddings": true,
    "max_position_embeddings": 262144,
    "layer_types": [
      "conv",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv",
      "full_attention",
      "conv",
      "sliding_attention",
      "conv",
      "full_attention",
      "conv"
    ]
  },
  "vision": false,
  "serving": {
    "think": {
      "end": "</think>",
      "open": "<think>",
      "open_token": "<think>"
    },
    "tool_dialect": "lfm25-python"
  },
  "tuning": [
    "VERIFY_TREE",
    "VERIFY_ALL_LIVE",
    "PREFILL_FAST_INT8",
    "ADAPTIVE_PROPOSALS",
    "DRAFT_BYPASS",
    "DRAFT_BYPASS_EXPECT",
    "DRAFT_CONF_MIN",
    "GPU_PREDRAFT",
    "PROPOSAL_CAP",
    "DRAFT_SPLITS",
    "PREFILL_SPLITS_MAX",
    "VERIFY_SPLITS_MAX",
    "VERIFY_SPLIT_R2",
    "HEAD_FUSED",
    "MTL4",
    "GGUF_PACKED",
    "SUBMIT_AHEAD",
    "ICB_OFF",
    "PREPARED_CACHE_OFF",
    "PATCHABLE_OFF",
    "NO_FUSED_GATE",
    "NGRAM_DRAFT_EXPECT",
    "NGRAM_WARMUP",
    "NGRAM_TREE_MIN",
    "TREE_ACCEPT_MAX",
    "TREE_ACCEPT_MIN",
    "ANE_WAIT",
    "DECODE_RING2",
    "DEVICE_VERIFY_PARAMS",
    "CONV_FUSE"
  ]
