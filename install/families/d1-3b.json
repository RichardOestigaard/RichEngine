{
  "name": "d1-3B",
  "repos": [
    "LiquidAI/d1-3B-GGUF"
  ],
  "note": "Liquid's d1-3B decision model: the LFM2.5-2.6B backbone post-trained for single-pass typed answers, distinguished from the generative checkpoint only by the GGUF's general.decision_type=lfm2-d1. Served text-only until the runtime enables its SigLIP2 NaFlex tower. No draft: a decision model never decodes, so speculative decode weights would install unused.",
  "signature": {
    "model_type": "lfm2",
    "decision_type": "lfm2-d1",
    "hidden_size": 2048,
    "num_hidden_layers": 30,
    "vocab_size": 128000,
    "num_attention_heads": 32,
    "num_key_value_heads": 8,
    "intermediate_size": 10752,
    "tie_word_embeddings": true,
    "layer_types": [
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv",
      "full_attention",
      "conv",
      "conv"
    ]
  },
  "vision": false,
  "serving": {
    "decision": true,
    "think": {
      "end": "</think>",
      "open": "<think>",
      "open_token": "<think>"
    },
    "tool_dialect": "lfm25-python"
  },
  "tuning": [
    "PREFILL_FAST_INT8",
    "PREFILL_SPLITS_MAX",
    "HEAD_FUSED",
    "MTL4",
    "GGUF_PACKED",
    "SUBMIT_AHEAD",
    "ICB_OFF",
    "PREPARED_CACHE_OFF",
    "PATCHABLE_OFF",
    "ANE_WAIT",
    "CONV_FUSE",
    "SCORE_GATHER",
    "SCORE_TENSOR",
    "SCORE_FUSED",
    "SCORE_TENSOR_PREFILL",
    "SYSTEMONE_WINDOW",
    "VERIFY_SPLIT_R2"
  ]
}
