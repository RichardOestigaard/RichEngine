{
 "name": "Maxwell-V1.0-Flash",
 "repos": [
  "maxwell-model/Maxwell-V1-Flash"
 ],
 "note": "Packed-only target: the runtime loads MDFM-packed files and no GGUF image plan or safetensors loader maps the maxwell_moe tensor set (packedOnly), so pack.layout states maxwellMoeTargetLayout's geometry (pack_layouts.MaxwellLayout). The checkpoint's single MTP layer (mtp_layers.0.*) is not packed yet: the package binds the Null draft until the phase-2 MTP draft lands.",
 "signature": {
  "model_type": "maxwell_moe",
  "hidden_size": 2048,
  "num_hidden_layers": 45,
  "vocab_size": 200704,
  "num_attention_heads": 32,
  "num_key_value_heads": 4,
  "num_experts": 256
 },
 "defaults": {
  "packed_format": "packed-maxwell",
  "quant": "q4"
 },
 "pack": {
  "layout": {
   "maximum_context_tokens": 262144,
   "layers": 45,
   "dense_layers": 3,
   "hidden_size": 2048,
   "vocabulary_size": 200704,
   "packed_full_width": 5120,
   "attention_width": 4096,
   "attention_query_heads": 32,
   "attention_kv_heads": 4,
   "attention_head_dimension": 128,
   "attention_qk_norm": true,
   "rotary_pairs": 64,
   "rotary_theta": 20000000.0,
   "stop_tokens": [200001, 2],
   "intermediate_size": 6144,
   "experts": 256,
   "experts_per_token": 12,
   "expert_intermediate_size": 512,
   "packed_expert_width": 512,
   "shared_intermediate_size": 1024,
   "packed_shared_width": 1024,
   "hyper_connections": 4,
   "indexer_heads": 4,
   "indexer_head_dimension": 128,
   "indexer_block_tokens": 128,
   "indexer_prefix_blocks": 8,
   "indexer_local_blocks": 8,
   "indexer_remote_blocks": 16,
   "mhc_mix_width": 24,
   "mhc_sinkhorn_iterations": 20
  },
  "execution_geometry": {
   "draft_proposal_tokens": 7,
   "draft_query_rows": 8
  }
 },
 "serving": {
  "think": {
   "end": "</think>",
   "open": "<think>",
   "open_token": "<think>"
  },
  "tool_dialect": "qwen3-xml"
 }
}
