  "draft": {
    "repo": "z-lab/gemma-4-26B-A4B-it-DFlash",
    "base": "dflash_gemma4",
    "signature": {
      "num_hidden_layers": 5,
      "num_target_layers": 30,
      "hidden_size": 2816,
      "vocab_size": 262144,
      "intermediate_size": 5632,
      "num_attention_heads": 32,
      "num_key_value_heads": 8,
      "head_dim": 128,
      "dflash_config.mask_token_id": 4,
      "dflash_config.target_layer_ids": [
        1,
        6,
        11,
        17,
        22,
        27
