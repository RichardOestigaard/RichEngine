    "moe_intermediate_size": 704,
    "enable_moe_block": true,
    "sliding_window": 1024,
    "num_kv_shared_layers": 0,
    "attention_k_eq_v": true,
    "final_logit_softcapping": 30.0,
    "tie_word_embeddings": true,
