  "serving": {
    "think": {
      "end": "<channel|>",
      "open": "<|channel>thought\n",
      "open_token": "<|channel>",
      "flag": "<|think|>"
    },
    "tool_dialect": "gemma4"
  },
  "pack": {
    "layout": {
      "layers": 30,
      "hidden": 2816,
      "vocabulary": 262144,
      "query_heads": 16,
      "kv_heads": 8,
      "head_dim": 256,
      "global_kv_heads": 2,
      "global_head_dim": 512,
      "global_period": 6,
      "experts": 128,
      "experts_per_token": 8,
      "expert_intermediate": 704,
      "packed_expert_width": 768,
      "shared_intermediate": 2112,
      "packed_shared_width": 2304,
      "sliding_window": 1024,
      "rotary_theta": 10000,
      "global_rotary_theta": 1000000,
      "logit_softcap": 30.0,
      "max_position_embeddings": 262144
