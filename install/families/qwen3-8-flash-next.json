  ],
  "note": "Packed-only target: the runtime loads MDFQ-packed files and no GGUF image plan or safetensors loader maps the qwen4exp tensor set (packedOnly), so pack.layout states qwen4ExpTargetLayout's geometry (pack_layouts.Qwen4ExpLayout). pack.draft_layout (kind dflash2, pack_layouts.DFlash2Layout) states the DFlash2 draft's packed geometry: install/pack.py emits its draft/*.bin files under MDFD0004 with the two dynamic projections per layer as F32 GGUF segments, and the manifest's draft object declares DFlash2DraftModel so runtime/model/families/Qwen4.mm's declared-draft binding applies.",
  "signature": {
    "model_type": "qwen4_exp_text",
    "max_position_embeddings": 262144,
    "hidden_size": 2560,
    "num_hidden_layers": 48,
    "vocab_size": 248320,
    "num_attention_heads": 24,
    "num_key_value_heads": 2,
    "head_dim": 256,
    "num_experts": 512
  },
