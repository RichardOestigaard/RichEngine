{
  "name": "MiniCPM-V-4.7-35B-A3B",
  "repos": [
    "openbmb/MiniCPM-V-4.7-35B-A3B-gguf"
  ],
  "note": "MiniCPM-V 4.7's language backbone is the qwen3_5_moe hybrid at vocab 248144 (unpadded, unlike the 248320 families). Its vision tower is a two-stage SigLIP merger the runtime does not serve. The draft is the Draftfit dialect of DSpark: the dflash fields nested under dflash_config plus a flat markov_rank and confidence-head flag at the root.",
  "signature": {
    "model_type": "qwen3_5_moe_text",
    "max_position_embeddings": 262144,
    "hidden_size": 2048,
    "num_hidden_layers": 40,
    "vocab_size": 248144,
    "num_attention_heads": 16,
    "num_key_value_heads": 2,
    "head_dim": 256,
    "num_experts": 256,
    "num_experts_per_tok": 8
  },
  "draft": {
    "repo": "openbmb/MiniCPM-V-4.7-35B-A3B-DSpark",
    "base": null,
    "signature": {
      "architectures": [
        "Qwen3DSparkModel"
      ],
      "model_type": "qwen3",
      "hidden_act": "silu",
      "num_hidden_layers": 5,
      "layer_types": [
        "full_attention",
        "full_attention",
        "full_attention",
        "full_attention",
        "full_attention"
      ],
      "markov_rank": 256,
      "enable_confidence_head": true,
      "hidden_size": 2048,
      "vocab_size": 248144,
      "draft_vocab_size": 248144,
      "intermediate_size": 6144,
      "num_attention_heads": 8,
      "num_key_value_heads": 2,
      "head_dim": 256,
      "block_size": 15,
      "max_position_embeddings": 262144,
      "rms_norm_eps": 1e-06,
