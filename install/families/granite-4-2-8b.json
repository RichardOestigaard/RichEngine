{
  "name": "Granite-4.2-8B",
  "repos": [
    "ibm-granite/granite-4.2-8b-GGUF"
  ],
  "note": "Same structure as the 3B at hidden 4096 and head_dim 128; no GPU draft \u2014 the n-gram predraft proposes. GGUF only.",
  "signature": {
    "model_type": "granite",
    "hidden_size": 4096,
    "num_hidden_layers": 40,
    "vocab_size": 100352,
    "num_attention_heads": 32,
    "num_key_value_heads": 8,
    "head_dim": 128,
    "intermediate_size": 12800,
    "max_position_embeddings": 131072,
    "rope_theta": 10000000.0,
    "attention_multiplier": 0.0078125
  },
  "vision": false,
  "serving": {
    "think": {
      "end": "</think>",
      "open": "<think>",
      "open_token": "<think>"
    },
    "tool_dialect": "qwen3-xml",
    "dfa_mode": "full"
  },
  "tuning": [
    {
      "env": "RICHENGINE_VERIFY_TREE",
      "values": [
        "0"
      ],
      "reason": "the n-gram comb tree vs the bare chain; on by default"
    },
    "VERIFY_ALL_LIVE",
    "VERIFY_SPLITS_MAX",
    "VERIFY_SPLIT_R2",
    "PREFILL_SPLITS_MAX",
    "NGRAM_PREDRAFT",
    "NGRAM_DRAFT_EXPECT",
    "NGRAM_WARMUP",
    "NGRAM_TREE_MIN",
    "TREE_ACCEPT_MIN",
    "TREE_ACCEPT_MAX",
    "ANE_WAIT",
    "PREFILL_FAST_INT8",
    "HEAD_FUSED",
    "MTL4",
    "SUBMIT_AHEAD",
    "ICB_OFF",
    "PREPARED_CACHE_OFF",
    "PATCHABLE_OFF",
    "NO_FUSED_GATE",
    "DECODE_RING2",
    "DEVICE_VERIFY_PARAMS"
  ]
}
